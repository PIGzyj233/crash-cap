# Keep the Core build context reproducible and free of local state, generated
# fixture binaries, reports, and credentials.  Source, contracts, and Cargo
# manifests remain included for the deploy/core Dockerfile.
.git
.gitignore
target
**/target
.runtime
**/.runtime
**/__pycache__
**/*.pyc
platform/.venv
platform/**/.venv
platform/**/node_modules
platform/**/dist
platform/**/.pytest_cache
platform/**/.ruff_cache
platform/**/.mypy_cache
platform/**/tsconfig*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
fixtures/**/generated
docs/evidence
