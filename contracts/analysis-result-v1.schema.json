{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/analysis-result-v1.schema.json",
  "title": "Crash-Cap Canonical Analysis Result stable v1.0",
  "description": "Stable v1.0 platform-facing analysis contract frozen after the Phase 0 Golden Dump gate. Engine-native JSON is stored separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "occurrence_id",
    "analysis_id",
    "engine",
    "build_resolution",
    "dump",
    "process",
    "crash",
    "threads",
    "modules",
    "quality",
    "fingerprints"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workspace_id": { "type": "string", "minLength": 1 },
    "occurrence_id": { "type": "string", "minLength": 1 },
    "analysis_id": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable analysis run id."
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_version",
        "core_image_digest",
        "symbolicator_version",
        "grouping_version",
        "normalization_version"
      ],
      "properties": {
        "core_version": { "type": "string" },
        "core_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "symbolicator_version": { "type": "string" },
        "grouping_version": { "type": "string" },
        "normalization_version": { "type": "string" }
      }
    },
    "build_resolution": { "$ref": "#/$defs/buildResolution" },
    "dump": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blob_id",
        "sha256",
        "kind",
        "size",
        "uploaded_at",
        "occurred_at",
        "time_source"
      ],
      "properties": {
        "blob_id": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": ["user_minidump", "kernel", "unknown_binary"]
        },
        "size": { "type": "integer", "minimum": 1 },
        "capture_profile": {
          "type": ["string", "null"],
          "enum": ["light-crash", "rich-crash", "hang", "full-memory", null]
        },
        "dump_timestamp": { "$ref": "#/$defs/nullableTimestamp" },
        "reported_at": { "$ref": "#/$defs/nullableTimestamp" },
        "uploaded_at": { "type": "string", "format": "date-time" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "time_source": {
          "type": "string",
          "enum": ["dump", "reported", "uploaded", "manual"]
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "os"],
      "properties": {
        "pid": { "type": ["integer", "null"], "minimum": 0 },
        "architecture": {
          "type": "string",
          "enum": ["x86_64", "x86", "arm64", "unknown"]
        },
        "os": { "type": "string" },
        "os_version": { "type": ["string", "null"] },
        "uptime_seconds": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "crash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "type_evidence"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["crash", "hang", "unknown"]
        },
        "type_evidence": {
          "type": "string",
          "enum": ["exception_stream", "reported_hang", "insufficient", "other"]
        },
        "thread_id": { "type": ["integer", "null"], "minimum": 0 },
        "exception_code": { "type": ["string", "null"] },
        "exception_name": { "type": ["string", "null"] },
        "access_type": {
          "type": ["string", "null"],
          "enum": ["read", "write", "execute", "readwrite", null]
        },
        "address": { "$ref": "#/$defs/hexAddr" },
        "fault_module": { "type": ["string", "null"] },
        "fault_module_debug_id": { "type": ["string", "null"] }
      }
    },
    "threads": {
      "type": "array",
      "items": { "$ref": "#/$defs/thread" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "symbol_coverage",
        "unwind_reliability",
        "artifact_completeness",
        "warnings"
      ],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "symbol_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "unwind_reliability": { "type": "number", "minimum": 0, "maximum": 1 },
        "artifact_completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualityWarning" }
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "family", "algorithm"],
      "properties": {
        "exact": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "description": "Null unless a matched fault module and at least one non-scan in-app frame exist."
        },
        "family": {
          "type": "null",
          "description": "Reserved. Phase 1 is always null."
        },
        "algorithm": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["crash"],
        "properties": {
          "crash": {
            "required": ["type"],
            "properties": {
              "type": { "enum": ["hang", "unknown"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "fingerprints": {
            "properties": {
              "exact": { "type": "null" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableTimestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "hexAddr": {
      "type": ["string", "null"],
      "pattern": "^0x[0-9a-f]+$"
    },
    "buildResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_build_id",
        "resolved_build_id",
        "resolution_method",
        "evidence"
      ],
      "properties": {
        "reported_build_id": { "type": ["string", "null"] },
        "resolved_build_id": { "type": ["string", "null"] },
        "resolution_method": {
          "type": "string",
          "enum": ["reported", "auto_unique", "manual", "ambiguous", "unresolved"]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_build_ids",
            "matched_entrypoints",
            "matched_owned_modules",
            "conflicting_modules"
          ],
          "properties": {
            "candidate_build_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "matched_entrypoints": {
              "type": "array",
              "items": { "type": "string" }
            },
            "matched_owned_modules": {
              "type": "array",
              "items": { "type": "string" }
            },
            "conflicting_modules": {
              "type": "array",
              "items": { "type": "string" }
            },
            "note": { "type": ["string", "null"] }
          }
        }
      }
    },
    "trust": {
      "type": "string",
      "enum": ["context", "cfi", "frame_pointer", "scan", "unknown"]
    },
    "moduleRole": {
      "type": "string",
      "enum": ["entrypoint", "owned", "dependency", "system", "unknown"]
    },
    "qualityWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "missing_pe",
            "missing_pdb",
            "pdb_mismatch",
            "pe_mismatch",
            "missing_pe_unwind",
            "system_symbol_pending",
            "system_symbol_failed",
            "truncated_dump",
            "scan_frames",
            "module_limit_truncated",
            "unsupported_inline",
            "ambiguous_build",
            "unresolved_build",
            "unknown_crash_type",
            "unclassified_exact",
            "other"
          ]
        },
        "message": { "type": "string" },
        "module": { "type": ["string", "null"] },
        "debug_id": { "type": ["string", "null"] }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "is_crashing", "frames"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "name": { "type": ["string", "null"] },
        "is_crashing": { "type": "boolean" },
        "frames": {
          "type": "array",
          "items": { "$ref": "#/$defs/frame" }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "instruction_addr", "trust", "in_app"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "instruction_addr": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "module": { "type": ["string", "null"] },
        "module_debug_id": { "type": ["string", "null"] },
        "relative_addr": { "$ref": "#/$defs/hexAddr" },
        "function": { "type": ["string", "null"] },
        "function_raw": { "type": ["string", "null"] },
        "function_normalized": { "type": ["string", "null"] },
        "function_offset": { "type": ["integer", "null"], "minimum": 0 },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 0 },
        "trust": { "$ref": "#/$defs/trust" },
        "in_app": { "type": "boolean" },
        "inline": { "type": "boolean" },
        "source_context": {
          "description": "Reserved. Phase 1 omits or sets null.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "pre": {
              "type": "array",
              "items": { "type": "string" }
            },
            "line": { "type": "string" },
            "post": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_file", "role", "in_app", "status", "artifact_ids"],
      "properties": {
        "code_file": { "type": "string" },
        "code_id": { "type": ["string", "null"] },
        "debug_file": { "type": ["string", "null"] },
        "debug_id": { "type": ["string", "null"] },
        "image_base": { "$ref": "#/$defs/hexAddr" },
        "image_size": { "type": ["integer", "null"], "minimum": 0 },
        "role": { "$ref": "#/$defs/moduleRole" },
        "in_app": { "type": "boolean" },
        "artifact_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "missing_pe",
            "missing_pdb",
            "pdb_mismatch",
            "pe_mismatch",
            "corrupted",
            "system_symbol_pending",
            "unsupported"
          ]
        }
      }
    }
  }
}


