{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/artifact-delivery-v2.schema.json",
  "title": "Crash-Cap Artifact Delivery v2 Response",
  "description": "Workspace-scoped PE/PDB delivery response with explicit logical and wire identities on upload.",
  "oneOf": [
    { "$ref": "#/$defs/upload" },
    { "$ref": "#/$defs/wait" },
    { "$ref": "#/$defs/reused" }
  ],
  "$defs": {
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "upload_id", "method", "url", "headers", "expires_in", "wire_encoding", "wire_size"],
      "properties": {
        "disposition": { "const": "upload" },
        "upload_id": { "type": "string", "pattern": "^upl_[0-9A-HJKMNP-TV-Z]{26}$" },
        "method": { "const": "PUT" },
        "url": { "type": "string", "format": "uri" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "expires_in": { "type": "integer", "minimum": 1 },
        "wire_encoding": { "enum": ["identity", "zstd-v1"] },
        "wire_size": { "type": "integer", "minimum": 1 },
        "multipart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["upload_id", "parts"],
          "properties": {
            "upload_id": { "type": "string", "minLength": 1 },
            "part_size": { "type": "integer", "minimum": 1 },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["part_number", "url"],
                "properties": {
                  "part_number": { "type": "integer", "minimum": 1 },
                  "url": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        }
      }
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "retry_after_seconds", "lease_expires_at"],
      "properties": {
        "disposition": { "const": "wait" },
        "retry_after_seconds": { "type": "integer", "minimum": 1 },
        "lease_expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "reused": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "artifact_blob_id", "artifact_id", "delivery"],
      "properties": {
        "disposition": { "const": "reused" },
        "artifact_blob_id": { "type": "string", "pattern": "^abl_[0-9A-HJKMNP-TV-Z]{26}$" },
        "artifact_id": { "type": "string", "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$" },
        "delivery": { "const": "reused" }
      }
    }
  }
}
