{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/artifact-selection-v1.schema.json",
  "title": "Crash-Cap Artifact Selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "mode",
    "workspace_id",
    "run_id",
    "inspect_sha256",
    "reported_build_id",
    "candidate_build_ids",
    "matched_module_ids",
    "selected_artifacts",
    "inventory_summary",
    "selection_summary",
    "materialization_summary"
  ],
  "properties": {
    "schema_version": { "const": "artifact-selection-v1" },
    "policy_version": { "const": "artifact-selection-v1" },
    "mode": { "enum": ["legacy", "shadow", "active"] },
    "workspace_id": { "type": "string", "pattern": "^wsp_" },
    "run_id": { "type": "string", "pattern": "^run_" },
    "inspect_sha256": { "$ref": "#/$defs/sha256" },
    "reported_build_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^bld_" }
      ]
    },
    "candidate_build_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^bld_" }
    },
    "matched_module_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^mod_" }
    },
    "selected_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "inventory_summary": { "$ref": "#/$defs/summary" },
    "selection_summary": { "$ref": "#/$defs/summary" },
    "materialization_summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_count", "artifact_bytes", "unique_blob_count", "unique_blob_bytes"],
      "properties": {
        "artifact_count": { "type": "integer", "minimum": 0 },
        "artifact_bytes": { "type": "integer", "minimum": 0 },
        "unique_blob_count": { "type": "integer", "minimum": 0 },
        "unique_blob_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "build_id",
        "module_id",
        "kind",
        "sha256",
        "size",
        "object_key",
        "selection_reasons"
      ],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^art_" },
        "build_id": { "type": "string", "pattern": "^bld_" },
        "module_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^mod_" }
          ]
        },
        "kind": { "enum": ["pe", "pdb", "source_bundle"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "object_key": { "type": "string", "minLength": 1 },
        "selection_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "code_id",
              "debug_id",
              "paired_artifact",
              "reported_build",
              "candidate_source_bundle"
            ]
          }
        }
      }
    }
  }
}
