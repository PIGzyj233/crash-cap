{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/build-manifest-v1.schema.json",
  "title": "Crash-Cap Build Manifest stable v1.0",
  "description": "Stable v1.0 build metadata contract. IDs supplied by the producer are hints; the platform derives authoritative code_id and debug_id from verified PE/PDB bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "version", "architecture", "modules"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "product": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Display and aggregation label; not unique and never a symbol matching key."
    },
    "channel": { "type": "string" },
    "commit": { "type": "string" },
    "build_number": { "type": "string" },
    "architecture": {
      "type": "string",
      "enum": ["x86_64", "x86", "arm64"]
    },
    "compiler": { "type": "string" },
    "toolchain": { "type": "string" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["role"],
        "properties": { "role": { "const": "entrypoint" } }
      },
      "minContains": 1,
      "items": { "$ref": "#/$defs/moduleHint" }
    }
  },
  "$defs": {
    "moduleHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_file", "debug_file", "role"],
      "properties": {
        "code_file": {
          "type": "string",
          "minLength": 1,
          "description": "EXE/DLL basename."
        },
        "debug_file": {
          "type": "string",
          "minLength": 1,
          "description": "PDB basename."
        },
        "role": {
          "type": "string",
          "enum": ["entrypoint", "owned", "dependency"]
        },
        "code_id": {
          "type": "string",
          "description": "Optional untrusted hint; overwritten from PE."
        },
        "debug_id": {
          "type": "string",
          "description": "Optional untrusted hint; overwritten from PE/PDB."
        }
      }
    }
  }
}


