{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/build-manifest-v2.schema.json",
  "title": "Crash-Cap Build Manifest stable v2.0",
  "description": "Phase 2 Build Manifest. It keeps v1 module semantics and adds a versioned source-bundle descriptor. Producer IDs remain hints; verified bytes remain authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "version", "architecture", "modules"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "channel": { "type": "string" },
    "commit": { "type": "string" },
    "build_number": { "type": "string" },
    "architecture": { "type": "string", "enum": ["x86_64", "x86", "arm64"] },
    "compiler": { "type": "string" },
    "toolchain": { "type": "string" },
    "source_bundle": { "$ref": "#/$defs/sourceBundle" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["role"],
        "properties": { "role": { "const": "entrypoint" } }
      },
      "minContains": 1,
      "items": { "$ref": "#/$defs/moduleHint" }
    }
  },
  "$defs": {
    "sourceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "archive", "source_root"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "archive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+\\.zip$"
        },
        "source_root": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "strip_prefixes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "context_lines": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "moduleHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_file", "debug_file", "role"],
      "properties": {
        "code_file": { "type": "string", "minLength": 1 },
        "debug_file": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["entrypoint", "owned", "dependency"] },
        "code_id": { "type": "string" },
        "debug_id": { "type": "string" }
      }
    }
  }
}
