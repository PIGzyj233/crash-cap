{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/build-publication-v1.schema.json",
  "title": "Crash-Cap Build Publication stable v1.0",
  "description": "Registers one idempotent local or CI publication of a stable Build Manifest and an exact PE/PDB inventory. The nested manifest is validated against its declared stable manifest contract by the API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "origin",
    "client_publication_id",
    "client_version",
    "git",
    "manifest",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "origin": { "type": "string", "enum": ["local", "ci"] },
    "client_publication_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "client_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "git": { "$ref": "#/$defs/gitState" },
    "manifest": {
      "type": "object",
      "description": "A Build Manifest v1.0 or v2.0; publication APIs reject source bundles in the first local-publication profile."
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/artifactExpectation" }
    }
  },
  "$defs": {
    "gitState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "worktree_state"],
      "properties": {
        "revision": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[0-9A-Fa-f]+$"
        },
        "worktree_state": {
          "type": "string",
          "enum": ["clean", "dirty", "unknown"]
        }
      }
    },
    "artifactExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_code_file", "kind", "logical_name", "size", "sha256"],
      "properties": {
        "module_code_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+$"
        },
        "kind": { "type": "string", "enum": ["pe", "pdb"] },
        "logical_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+$"
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 8589934592 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
