{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "role_policy_sha256",
    "source_policy_sha256",
    "capture_profile",
    "core_image_digest",
    "symbolicator_image_digest",
    "symbolicator_version",
    "normalization_version",
    "grouping_version",
    "inspector_version",
    "canonical_version",
    "selection_version"
  ],
  "properties": {
    "schema_version": {
      "const": "analysis-context-v3"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "role_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture_profile": {
      "enum": [
        null,
        "light-crash",
        "rich-crash",
        "hang",
        "full-memory"
      ]
    },
    "core_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "symbolicator_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "symbolicator_version": {
      "type": "string",
      "minLength": 1
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "grouping_version": {
      "type": "string",
      "minLength": 1
    },
    "inspector_version": {
      "type": "string",
      "minLength": 1
    },
    "canonical_version": {
      "const": "2.0"
    },
    "selection_version": {
      "const": "pair-selection-v1"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/drafts/qa-symbol-import/analysis-context-v3.schema.json",
  "title": "Analysis Context v3",
  "$comment": "Current internal contract for upload v3; generated by the platform, not supplied by upload clients."
}
