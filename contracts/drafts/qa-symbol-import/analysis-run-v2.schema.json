{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "occurrence_id",
    "demand_id",
    "demand_generation",
    "retry_attempt",
    "reason",
    "dump",
    "result_facts",
    "policy_snapshots",
    "source_bundle_locations",
    "inspect",
    "resolution_manifest",
    "resolution_evidence_fingerprint",
    "context",
    "context_sha256",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "analysis-run-v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1
    },
    "demand_id": {
      "type": "string",
      "minLength": 1
    },
    "demand_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "retry_attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "enum": [
        "initial",
        "symbol_refresh",
        "role_change",
        "engine_upgrade",
        "evidence_correction",
        "manual"
      ]
    },
    "dump": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "object_key",
        "size"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "object_key": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "result_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dump"
      ],
      "properties": {
        "dump": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blob_id",
            "sha256",
            "kind",
            "size",
            "capture_profile",
            "dump_timestamp",
            "reported_at",
            "uploaded_at",
            "occurred_at",
            "time_source"
          ],
          "properties": {
            "blob_id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "user_minidump",
                "kernel",
                "unknown_binary"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "capture_profile": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "light-crash",
                "rich-crash",
                "hang",
                "full-memory",
                null
              ]
            },
            "dump_timestamp": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "reported_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "uploaded_at": {
              "type": "string",
              "format": "date-time"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time"
            },
            "time_source": {
              "type": "string",
              "enum": [
                "dump",
                "reported",
                "uploaded",
                "manual"
              ]
            }
          }
        }
      }
    },
    "policy_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_snapshot",
        "role_policy",
        "source_policy"
      ],
      "properties": {
        "build_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "builds"
          ],
          "properties": {
            "schema_version": {
              "const": "frozen-builds-v1"
            },
            "builds": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "build_id",
                  "workspace_id",
                  "manifest_sha256",
                  "verified_modules",
                  "manifest"
                ],
                "properties": {
                  "build_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "workspace_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "manifest_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "verified_modules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "module_id",
                        "manifest_module_index",
                        "identity",
                        "role",
                        "verified_pair_ids",
                        "artifact_ids"
                      ],
                      "properties": {
                        "module_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "manifest_module_index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "identity": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "code_id",
                            "debug_id",
                            "architecture"
                          ],
                          "properties": {
                            "code_id": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{9,24}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "debug_id": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{33,40}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "architecture": {
                              "enum": [
                                "x86_64",
                                "x86",
                                "arm64",
                                "unknown"
                              ]
                            }
                          }
                        },
                        "role": {
                          "enum": [
                            "entrypoint",
                            "owned",
                            "dependency"
                          ]
                        },
                        "verified_pair_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "uniqueItems": true
                        },
                        "artifact_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        }
                      }
                    }
                  },
                  "manifest": {
                    "oneOf": [
                      {
                        "$ref": "https://crash-cap.local/contracts/build-manifest-v0.schema.json"
                      },
                      {
                        "$ref": "https://crash-cap.local/contracts/build-manifest-v1.schema.json"
                      },
                      {
                        "$ref": "https://crash-cap.local/contracts/build-manifest-v2.schema.json"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "role_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "modules"
          ],
          "properties": {
            "schema_version": {
              "const": "workspace-role-policy-v1"
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "module_index",
                  "identity",
                  "role",
                  "in_app"
                ],
                "properties": {
                  "module_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "identity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "code_id",
                      "debug_id",
                      "architecture"
                    ],
                    "properties": {
                      "code_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{9,24}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "debug_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{33,40}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "architecture": {
                        "enum": [
                          "x86_64",
                          "x86",
                          "arm64",
                          "unknown"
                        ]
                      }
                    }
                  },
                  "role": {
                    "enum": [
                      "entrypoint",
                      "owned",
                      "dependency",
                      "system",
                      "unknown"
                    ]
                  },
                  "in_app": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "source_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "pair_source_protocol",
            "public_sources",
            "bundles"
          ],
          "properties": {
            "schema_version": {
              "const": "frozen-source-policy-v1"
            },
            "pair_source_protocol": {
              "const": "pair-http-v2"
            },
            "public_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "url",
                  "layout",
                  "filters",
                  "is_public"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "const": "http"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://",
                    "format": "uri"
                  },
                  "layout": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "symstore",
                          "unified"
                        ]
                      },
                      "casing": {
                        "const": "lowercase"
                      }
                    }
                  },
                  "filters": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "filetypes"
                    ],
                    "properties": {
                      "filetypes": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "pe",
                            "pdb",
                            "portablepdb"
                          ]
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "path_patterns": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    }
                  },
                  "is_public": {
                    "const": true
                  }
                }
              }
            },
            "bundles": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "build_id",
                  "artifact_id",
                  "sha256",
                  "size",
                  "descriptor"
                ],
                "properties": {
                  "build_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "descriptor": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version",
                      "archive",
                      "source_root"
                    ],
                    "properties": {
                      "schema_version": {
                        "const": "1.0"
                      },
                      "archive": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "pattern": "^[^/\\\\]+\\.zip$"
                      },
                      "source_root": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "description": "Normalized producer checkout root used only to strip Symbolicator file paths; it is never opened on the server."
                      },
                      "strip_prefixes": {
                        "type": "array",
                        "maxItems": 32,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024
                        }
                      },
                      "context_lines": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10,
                        "default": 3
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source_bundle_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "content"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_key",
              "sha256"
            ],
            "properties": {
              "object_key": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_key",
        "sha256"
      ],
      "properties": {
        "object_key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "resolution_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_key",
        "sha256"
      ],
      "properties": {
        "object_key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "resolution_evidence_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context": {
      "$ref": "analysis-context-v2.schema.json"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/drafts/qa-symbol-import/analysis-run-v2.schema.json",
  "title": "DRAFT QAI S0 analysis-run-v2",
  "$comment": "Unpublished. S1 real qualification required before freeze; no production writer may emit this draft."
}
