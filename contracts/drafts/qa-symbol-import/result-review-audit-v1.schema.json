{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/drafts/qa-symbol-import/result-review-audit-v1.schema.json",
  "title": "DRAFT QAI immutable result review evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "occurrence_id",
    "request",
    "request_sha256",
    "created_at",
    "current_evidence",
    "candidate_evidence",
    "provider_basis"
  ],
  "properties": {
    "schema_version": {
      "const": "result-review-audit-v1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^rrv_[0-9A-HJKMNP-TV-Z]{26}$",
      "maxLength": 30
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "request": {
      "$ref": "result-review-request-v1.schema.json"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "current_evidence": {
      "$ref": "comparison-evidence-v1.schema.json"
    },
    "candidate_evidence": {
      "$ref": "comparison-evidence-v1.schema.json"
    },
    "provider_basis": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "pair_id",
          "qualification_version",
          "state",
          "reason",
          "object_key",
          "sha256"
        ],
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "pair_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "qualification_version": {
            "type": "integer",
            "minimum": 2
          },
          "state": {
            "enum": [
              "active",
              "withdrawn"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "object_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "$comment": "Current internal contract for upload v3; generated by the platform, not supplied by upload clients."
}
