{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotency_key",
    "source_label",
    "pairs"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "source_label": {
      "type": "string",
      "minLength": 1
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_pair_id",
          "pe",
          "pdb"
        ],
        "properties": {
          "client_pair_id": {
            "type": "string",
            "minLength": 1
          },
          "pe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "raw_sha256",
              "raw_size"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "raw_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "pdb": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "raw_sha256",
              "raw_size"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "raw_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 200
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/drafts/qa-symbol-import/symbol-import-request-v1.schema.json",
  "title": "DRAFT QAI S0 symbol-import-request-v1",
  "$comment": "Unpublished. S1 real qualification required before freeze; no production writer may emit this draft."
}
