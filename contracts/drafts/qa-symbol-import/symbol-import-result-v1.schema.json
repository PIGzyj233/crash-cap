{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "import_id",
    "items"
  ],
  "properties": {
    "import_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "client_pair_id",
          "state",
          "pair_id",
          "error_code",
          "pe_upload_id",
          "pdb_upload_id"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "client_pair_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "staging",
              "queued",
              "verifying",
              "available",
              "rejected",
              "retry_exhausted"
            ]
          },
          "pair_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "pe_upload_id": {
            "type": "string",
            "minLength": 1
          },
          "pdb_upload_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/drafts/qa-symbol-import/symbol-import-result-v1.schema.json",
  "title": "DRAFT QAI S0 symbol-import-result-v1",
  "$comment": "Unpublished. S1 real qualification required before freeze; no production writer may emit this draft."
}
