{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crash-cap.local/contracts/task-message-v1.1.schema.json",
  "title": "Crash-Cap Task Message v1.1",
  "description": "Additive durable task contract for Artifact Blob pair publication. Existing task messages retain stable v1.0.",
  "oneOf": [
    { "$ref": "#/$defs/ingestArtifactBlob" },
    { "$ref": "#/$defs/publishArtifactBlobPair" }
  ],
  "$defs": {
    "common": {
      "schema_version": { "const": "1.1" },
      "attempt_id": { "type": "string", "minLength": 1 },
      "queue": { "const": "ingest" },
      "request_id": { "type": "string" }
    },
    "ingestArtifactBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "task_type", "artifact_id", "upload_id", "attempt_id", "queue"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/common/schema_version" },
        "task_type": { "const": "ingest_artifact" },
        "artifact_id": { "type": "string", "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$" },
        "upload_id": { "type": "string", "pattern": "^upl_[0-9A-HJKMNP-TV-Z]{26}$" },
        "attempt_id": { "$ref": "#/$defs/common/attempt_id" },
        "queue": { "$ref": "#/$defs/common/queue" },
        "request_id": { "$ref": "#/$defs/common/request_id" }
      }
    },
    "publishArtifactBlobPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "task_type", "artifact_blob_pair_id", "attempt_id", "queue"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/common/schema_version" },
        "task_type": { "const": "publish_artifact_blob_pair" },
        "artifact_blob_pair_id": { "type": "string", "pattern": "^abp_[0-9A-HJKMNP-TV-Z]{26}$" },
        "attempt_id": { "$ref": "#/$defs/common/attempt_id" },
        "queue": { "$ref": "#/$defs/common/queue" },
        "request_id": { "$ref": "#/$defs/common/request_id" }
      }
    }
  }
}
