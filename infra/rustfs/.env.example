# Copy to a temporary, mode-0600 env file when running the qualification.
# Never commit real credentials. The supplied run.sh creates random values.
RUSTFS_ACCESS_KEY=replace-with-a-random-access-key
RUSTFS_SECRET_KEY=replace-with-a-random-secret-key
RUSTFS_RPC_SECRET=replace-with-a-different-random-rpc-secret
RUSTFS_SSE_S3_MASTER_KEY=replace-with-a-base64-encoded-random-32-byte-key
