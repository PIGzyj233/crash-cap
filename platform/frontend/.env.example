# Stable Crash-Cap HTTP API prefix. The client defaults to /api/v1.
VITE_API_BASE_URL=/api/v1

# Use the built-in fixture for local UI work when the platform API is not running.
VITE_USE_MOCK=true

# Keep false in the default trusted-intranet deployment. The API remains the authority.
VITE_RAW_DOWNLOAD_ENABLED=false
