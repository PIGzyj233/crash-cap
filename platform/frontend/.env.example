# Vite dev server has no API proxy. Connect to the local Compose API.
# Allow http://127.0.0.1:5173 in both API and S3 CORS (see the root README).
# Docker builds use /api/v3 for the same-origin Nginx proxy instead.
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v3

# Keep false in the default trusted-intranet deployment. The API remains the authority.
VITE_RAW_DOWNLOAD_ENABLED=false
